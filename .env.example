# Next stuff
NEXT_TELEMETRY_DISABLED=1

# Website version
NEXT_PUBLIC_VERSION=2.5.0
VERSION=2.5.0

# API URL is mandatory
API_URL=https://api.croustillant.menu/v1

# API Key is optional, necessary for the production environment to bypass the rate limit
API_KEY=

# Necessary for the production environment to redirect to display images in the meta tags & sitemap
WEB_URL=https://croustillant.menu

# GitHub token is optional, raises the rate limit of the changelog page (public repositories, no scope needed)
GITHUB_TOKEN=

# Umami Analytics
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_HOSTNAME=
